generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
}

model Rol {
  id            Int          @id @default(autoincrement()) @map("PK_id_rol")
  nombre        String       @map("Nombre") @db.VarChar(100)
  descripcion   String?
  estado        String       @default("Activo") @map("Estado") @db.VarChar(30)
  rolesPermisos RolPermiso[]
  usuarios      Usuario[]

  @@map("Roles")
}

model Permiso {
  id            Int          @id @default(autoincrement()) @map("PK_id_permisos")
  nombre        String       @map("Nombre") @db.VarChar(100)
  rolesPermisos RolPermiso[]

  @@map("Permisos")
}

model RolPermiso {
  id        Int     @id @default(autoincrement()) @map("PK_id_roles_permisos")
  rolId     Int     @map("FK_id_rol")
  permisoId Int     @map("FK_id_permiso")
  permiso   Permiso @relation(fields: [permisoId], references: [id], onUpdate: NoAction)
  rol       Rol     @relation(fields: [rolId], references: [id], onUpdate: NoAction)

  @@map("Roles_Permisos")
}

model Usuario {
  id                  Int                  @id @default(autoincrement()) @map("PK_id_usuario")
  correo              String               @unique @map("Correo") @db.VarChar(100)
  contrasena          String               @map("Contrasena") @db.VarChar(256)
  estado              String               @default("Activo") @map("Estado") @db.VarChar(30)
  rolId               Int                  @map("FK_id_rol")
  foto_perfil         String?
  nombre              String?              @db.VarChar(100)
  apellido            String?              @db.VarChar(100)
  telefono            String?              @db.VarChar(20)
  Cliente             Cliente[]
  empleado            Empleado[]
  horarioChanges      HorarioHistorial[]
  rol                 Rol                  @relation(fields: [rolId], references: [id], onUpdate: NoAction)
  resetPasswordTokens ResetPasswordToken[]

  @@map("Usuarios")
}

model ResetPasswordToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("FK_id_usuario")
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expiresAt")
  createdAt DateTime @default(now()) @map("createdAt")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("ResetPasswordToken")
  @@index([usuarioId])
  @@index([expiresAt])
}

model Empleado {
  id              Int                   @id @default(autoincrement()) @map("PK_id_empleado")
  nombre          String                @db.VarChar(100)
  apellido        String                @db.VarChar(100)
  tipoDocumento   String?               @map("tipo_documento") @db.VarChar(30)
  numeroDocumento String?               @map("numero_documento") @db.VarChar(20)
  correo          String?               @db.VarChar(100)
  telefono        String?               @db.VarChar(20)
  ciudad          String?               @db.VarChar(40)
  especialidad    String?               @db.VarChar(50)
  direccion       String?               @db.VarChar(190)
  fotoPerfil      String?               @map("foto_perfil") @db.VarChar(500)
  estado          String                @default("Activo") @map("Estado") @db.VarChar(30)
  usuarioId       Int                   @map("fk_id_usuario")
  usuario         Usuario               @relation(fields: [usuarioId], references: [id], onUpdate: NoAction)
  empleadoServicios    EmpleadoServicio[]
  horarios             Horario[]
  horarioHistorial     HorarioHistorial[]
  agendamientoDetalles AgendamientoDetalle[]
  ventaDetalles        VentaDetalle[]

  @@map("Empleado")
}

model Horario {
  id         Int       @id @default(autoincrement()) @map("PK_id_horario")
  empleadoId Int       @map("FK_id_empleado")
  horaInicio DateTime  @map("hora_inicio") @db.Time(6)
  horaFinal  DateTime  @map("hora_final") @db.Time(6)
  fecha      DateTime  @db.Date
  diaSemana  String?   @map("dia_semana") @db.VarChar(20)
  empleado   Empleado  @relation(fields: [empleadoId], references: [id], onUpdate: NoAction)
  novedades  Novedad[]

  @@map("Horarios")
}

model Novedad {
  id          Int       @id @default(autoincrement()) @map("PK_id_novedad")
  horarioId   Int       @map("FK_id_horario")
  tipoNovedad String?   @map("tipo_novedad") @db.VarChar(100)
  descripcion String?   @db.VarChar(600)
  fechaInicio DateTime? @map("fecha_inicio") @db.Date
  fechaFinal  DateTime? @map("fecha_final") @db.Date
  horaInicio  DateTime? @map("hora_inicio") @db.Time(6)
  horaFinal   DateTime? @map("hora_final") @db.Time(6)
  estado      String    @default("Activo") @map("Estado") @db.VarChar(30)
  horario     Horario   @relation(fields: [horarioId], references: [id], onUpdate: NoAction)

  @@map("Novedades")
}

model CategoriaServicio {
  id          Int        @id @default(autoincrement()) @map("PK_id_categoria_servicios")
  nombre      String     @map("Nombre") @db.VarChar(100)
  descripcion String?    @db.VarChar(600)
  color       String?    @db.VarChar(20)
  estado      String     @default("Activo") @map("Estado") @db.VarChar(30)
  servicios   Servicio[]

  @@map("Categoria_servicios")
}

model Servicio {
  id                   Int                   @id @default(autoincrement()) @map("PK_id_servicio")
  categoriaId          Int                   @map("FK_categoria_servicios")
  nombre               String                @db.VarChar(100)
  descripcion          String?               @db.VarChar(600)
  duracion             Int?                  @map("Duracion")
  precio               Decimal?              @map("Precio") @db.Decimal(10, 2)
  estado               String                @default("Activo") @map("Estado") @db.VarChar(30)
  imagenServicio       String?               @map("imagen_servicio") @db.VarChar(500)
  agendamientoDetalles AgendamientoDetalle[]
  detalleCotizaciones  DetalleCotizacion[]
  empleadoServicios    EmpleadoServicio[]
  categoria            CategoriaServicio     @relation(fields: [categoriaId], references: [id], onUpdate: NoAction)
  ventaDetalles        VentaDetalle[]

  @@map("Servicio")
}

model EmpleadoServicio {
  id         Int      @id @default(autoincrement()) @map("PK_id_Empleado_Servicio")
  servicioId Int      @map("FK_id_servicio")
  empleadoId Int      @map("FK_id_empleado")
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onUpdate: NoAction)
  servicio   Servicio @relation(fields: [servicioId], references: [id], onUpdate: NoAction)

  @@map("Empleado_Servicio")
}

model Cotizacion {
  id         Int                 @id @default(autoincrement()) @map("PK_id_cotizacion")
  clienteId  Int?                @map("FK_id_cliente")
  fecha      DateTime?           @map("Fecha") @db.Date
  valor      Decimal?            @map("Valor") @db.Decimal(10, 2)
  iva        Decimal?            @map("Iva") @db.Decimal(10, 2)
  subtotal   Decimal?            @map("Subtotal") @db.Decimal(10, 2)
  descuento  Decimal?            @map("Descuento") @db.Decimal(10, 2)
  notas      String?             @map("Notas") @db.VarChar(900)
  horaInicio DateTime?           @map("Hora_inicio") @db.Time(6)
  total      Decimal?            @map("TOTAL") @db.Decimal(12, 2)
  estado     String              @default("Activo") @map("Estado") @db.VarChar(30)
  citas      AgendamientoCita[]
  cliente    Cliente?            @relation(fields: [clienteId], references: [PK_id_cliente], onDelete: NoAction, onUpdate: NoAction)
  detalles   DetalleCotizacion[]

  @@map("Cotizacion")
}

model DetalleCotizacion {
  id           Int        @id @default(autoincrement()) @map("PK_id_detalle_cotizacion")
  cotizacionId Int        @map("FK_id_cotizacion")
  servicioId   Int        @map("FK_id_servicio")
  precio       Decimal?   @map("Precio") @db.Decimal(10, 2)
  cantidad     Int        @default(1) @map("Cantidad")
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onUpdate: NoAction)
  servicio     Servicio   @relation(fields: [servicioId], references: [id], onUpdate: NoAction)

  @@map("Detalle_cotizacion")
}

model AgendamientoCita {
  id           Int                   @id @default(autoincrement()) @map("PK_id_cita")
  clienteId    Int?                  @map("FK_id_cliente")
  cotizacionId Int?                  @map("FK_id_cotizacion")
  horario      DateTime?             @map("Horario") @db.Time(6)
  fecha        DateTime              @map("Fecha") @db.Date
  estado       String                @default("Pendiente") @map("Estado") @db.VarChar(30)
  notas        String?               @map("Notas") @db.VarChar(300)
  cliente      Cliente?              @relation(fields: [clienteId], references: [PK_id_cliente], onDelete: NoAction, onUpdate: NoAction)
  cotizacion   Cotizacion?           @relation(fields: [cotizacionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  detalles     AgendamientoDetalle[]
  Venta        Venta[]

  @@map("Agendamiento_citas")
}

model AgendamientoDetalle {
  id         Int              @id @default(autoincrement()) @map("PK_id_agendamiento_detalle")
  citaId     Int              @map("FK_id_agendamiento_cita")
  servicioId Int              @map("FK_id_servicios")
  empleadoId Int?             @map("FK_id_empleado")
  precio     Decimal?         @map("Precio") @db.Decimal(10, 2)
  detalle    String?          @map("Detalle") @db.VarChar(500)
  servicio   Servicio         @relation(fields: [servicioId], references: [id], onUpdate: NoAction)
  cita       AgendamientoCita @relation(fields: [citaId], references: [id], onUpdate: NoAction)
  empleado   Empleado?        @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("Agendamiento_detalle")
}

model VentaDetalle {
  id          Int       @id @default(autoincrement()) @map("PK_id_venta_detalle")
  FK_id_venta Int       @map("FK_id_venta")
  servicioId  Int?      @map("FK_id_servicio")
  empleadoId  Int?      @map("FK_id_empleado")
  cantidad    Int       @default(1) @map("Cantidad")
  precio      Decimal   @map("Precio") @db.Decimal(12, 2)
  subtotal    Decimal   @map("Subtotal") @db.Decimal(12, 2)
  detalle     String?   @map("Detalle") @db.VarChar(500)
  Venta       Venta     @relation(fields: [FK_id_venta], references: [PK_id_venta_encabezado], onUpdate: NoAction)
  empleado    Empleado? @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  servicio    Servicio? @relation(fields: [servicioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("Venta_detalle")
}

model Cliente {
  PK_id_cliente    Int                @id @default(autoincrement())
  nombre           String             @db.VarChar(100)
  apellido         String             @db.VarChar(100)
  tipo_documento   String?            @db.VarChar(30)
  numero_documento String?            @db.VarChar(20)
  correo           String?            @db.VarChar(100)
  telefono         String?            @db.VarChar(20)
  direccion        String?            @db.VarChar(190)
  foto_perfil      String             @db.VarChar(500)
  Estado           String             @default("Activo") @db.VarChar(30)
  fk_id_usuario    Int
  citas            AgendamientoCita[]
  Usuarios         Usuario            @relation(fields: [fk_id_usuario], references: [id], onUpdate: NoAction)
  cotizaciones     Cotizacion[]
  Venta            Venta[]
}

model Venta {
  PK_id_venta_encabezado Int               @id @default(autoincrement()) @map("PK_id_venta")
  FK_id_cliente          Int?
  FK_id_cita             Int?
  Iva                    Decimal?          @db.Decimal(10, 2)
  Fecha                  DateTime?         @db.Date
  Total                  Decimal?          @db.Decimal(12, 2)
  descuento              Decimal?          @db.Decimal(10, 2)
  metodo_pago            String?           @db.VarChar(40)
  Estado                 String            @default("Activo") @db.VarChar(30)
  Agendamiento_citas     AgendamientoCita? @relation(fields: [FK_id_cita], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Cliente                Cliente?          @relation(fields: [FK_id_cliente], references: [PK_id_cliente], onDelete: NoAction, onUpdate: NoAction)
  Venta_detalle          VentaDetalle[]

  @@map("Venta")
}

model HorarioHistorial {
  id               Int      @id @default(autoincrement()) @map("PK_id_horario_historial")
  empleadoId       Int      @map("FK_id_empleado")
  weekStartDate    DateTime @map("week_start_date") @db.Date
  versionNumber    Int      @default(1) @map("version_number")
  changeReason     String?  @map("change_reason") @db.VarChar(500)
  changedBy        Int?     @map("changed_by")
  createdAt        DateTime @default(now()) @map("created_at")
  scheduleSnapshot String   @map("schedule_snapshot") @db.Text
  empleado         Empleado @relation(fields: [empleadoId], references: [id], onUpdate: NoAction)
  usuario          Usuario? @relation(fields: [changedBy], references: [id], onUpdate: NoAction)

  @@unique([empleadoId, weekStartDate, versionNumber])
  @@index([empleadoId, weekStartDate])
  @@index([createdAt])
  @@map("Horario_Historial")
}